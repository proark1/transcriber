# Application
APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:5173
APP_USERNAME=replace-me
APP_PIN_HASH=replace-with-an-argon2id-hash
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_SECURE_COOKIES=false
APP_LOG_LEVEL=INFO
SESSION_LIFETIME_SECONDS=604800
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOGIN_MAX_FAILURES=5
UPLOAD_SESSION_SECONDS=86400
PRESIGNED_URL_SECONDS=900

# PostgreSQL
DATABASE_URL=postgresql+psycopg://transcriber:transcriber_dev@localhost:5432/transcriber

# S3-compatible storage (MinIO locally, Railway Bucket in production)
BUCKET_ENDPOINT=http://localhost:9000
BUCKET_NAME=transcriber
BUCKET_ACCESS_KEY_ID=transcriber
BUCKET_SECRET_ACCESS_KEY=transcriber_dev_secret
BUCKET_REGION=auto
BUCKET_URL_STYLE=path

# Media limits and processing
MAX_RECORDING_BYTES=5000000000
MAX_RECORDING_SECONDS=14400
UPLOAD_PART_BYTES=33554432
CHUNK_CORE_SECONDS=1200
CHUNK_BOUNDARY_SEARCH_SECONDS=30
CHUNK_OVERLAP_SECONDS=5
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_CACHE=.models
WORKER_SCRATCH_DIR=.scratch
